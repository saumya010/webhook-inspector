# Copy to .env for local (non-Docker) dev. Docker Compose sets its own
# equivalents in docker-compose.yml — this file is for `npm run dev`.

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=webhook_inspector
PORT=3000

# Auth for /api/*. If unset, the API auth check is skipped (local dev only).
API_KEY=dev-local-key

# Per-endpoint webhook secrets. The name is whatever you set as
# `verification.secret_ref` when creating the endpoint — convention is
# WEBHOOK_SECRET_<SLUG_UPPERCASE>.
# WEBHOOK_SECRET_STRIPE_TEST=whsec_...
# WEBHOOK_SECRET_GITHUB_TEST=...
# WEBHOOK_SECRET_GENERIC_TEST=...
